# Copy this file to backend/.env and fill in the secrets.
# backend/.env is in .gitignore: never commit it, never print it.
# An empty value means "use the default".

# Secrets
GROQ_API_KEY=
JWT_SECRET=

# Accounts and API
JWT_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=5
INVITE_DAYS=7

# Storage (default: sqlite:///backend/data/fba.db)
DATABASE_URL=
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Embeddings
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Models (Groq). Llama 3.3 70B and 3.1 8B are not available on Groq for this project (checked 4 Nov 2026).
MODEL_MAIN=openai/gpt-oss-120b
MODEL_SMALL=openai/gpt-oss-20b
# main or small: the model behind POST /chat
AGENT_MODEL=main
REASONING_EFFORT=low
LLM_MAX_STEPS=6
LLM_MAX_TOKENS=600
LLM_TIMEOUT=30
# native = Groq tool calling; json = fallback with the same schemas inside the prompt (§6.3)
TOOL_MODE=native

# Agent
# Conversation memory; MEMORY_MESSAGES=0 switches it off (single-message evaluation)
MEMORY_MESSAGES=10
MEMORY_HOURS=24
MEMORY_MAX_TOKENS=600
AGENT_TODAY=
WEEK_START=saturday
TREND_THRESHOLD=0.3
CORRECTIONS_ENABLED=false
# One repair attempt when a reply has numbers that are not in the tool results
GROUNDING_REPAIR=true

# Development seed (python -m app.db.seed)
SEED_MANAGER_PASSWORD=
SEED_MEMBER_PASSWORD=
