# Copy this file to backend/.env and fill in the secrets.
# backend/.env is in .gitignore: never commit it, never print it.
# An empty value means "use the default".

# Secrets
GROQ_API_KEY=
JWT_SECRET=

# Storage (default: sqlite:///backend/data/fba.db)
DATABASE_URL=
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Embeddings
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Models (Groq). Llama 3.3 70B and 3.1 8B are not available on Groq for this project (checked 4 Nov 2026).
MODEL_MAIN=openai/gpt-oss-120b
MODEL_SMALL=openai/gpt-oss-20b
REASONING_EFFORT=low
LLM_MAX_STEPS=6
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
# native = Groq tool calling; json = fallback with the same schemas inside the prompt (§6.3)
TOOL_MODE=native

# Agent
AGENT_TODAY=
WEEK_START=saturday
TREND_THRESHOLD=0.3
CORRECTIONS_ENABLED=false

# Development seed (python -m app.db.seed)
SEED_MANAGER_PASSWORD=
SEED_MEMBER_PASSWORD=
