# Copy this file to backend/.env and fill in the secrets.
# backend/.env is in .gitignore: never commit it, never print it.
# An empty value means "use the default".

# Secrets
GROQ_API_KEY=
JWT_SECRET=

# Storage (default: sqlite:///backend/data/fba.db)
DATABASE_URL=
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Embeddings
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Models (Groq)
MODEL_MAIN=llama-3.3-70b-versatile
MODEL_SMALL=

# Agent
AGENT_TODAY=
WEEK_START=saturday
TREND_THRESHOLD=0.3
CORRECTIONS_ENABLED=false

# Development seed (python -m app.db.seed)
SEED_MANAGER_PASSWORD=
SEED_MEMBER_PASSWORD=
